{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test scripts/browser-regressions.test.mjs",
    "test:prerender": "npm run build && node --test scripts/prerender.test.mjs",
    "test:deployed": "node --test scripts/deployed-smoke.test.mjs",
    "benchmark:render": "npm run build && node --test scripts/benchmark-rendering.test.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
